# =============================================================
#  wg-clients.env.example — конфиг bash-скриптов управления клиентами
#  Путь: "/opt/wg-watch/conf/wg-clients.env.example"
#  Права: "chmod 600", владелец "root".
#  Формат: "KEY=value"
#  Читается через: "source" / "."
#  Скопируйте в wg-clients.env и заполните реальными значениями.
# =============================================================

# ---------- Пути ----------
SERVER_CONFIG="/etc/wireguard/wg0.conf"
CLIENTS_DIR="/etc/wireguard/clients"
SERVER_PUBLIC_KEY_FILE="/etc/wireguard/SRV-Depo-public.key"
WG_IFACE="wg0"
LOCK_FILE="/run/wg-watch/clients.lock"
# Должен совпадать с EVENTS_FILE в wg-watch-daemon.env
EVENTS_FILE="/opt/wg-watch/logs/events.log"

# ---------- Настройки клиентского VPN ----------
# DNS-сервер(ы) для клиентов, через запятую, без пробелов.
DNS="10.10.10.1"
# Маршруты, доступные клиенту, через запятую, без пробелов.
ALLOWED_IPS="10.10.10.0/24,192.168.0.200/32"
# Внешний адрес сервера в формате "host:port"
SERVER_ENDPOINT="vpn.example.org:51820"

# ---------- Подсеть клиентов ----------
CLIENT_SUBNET_PREFIX=10.10.10
CLIENT_IP_MIN=2
CLIENT_IP_MAX=254
SERVER_IP_LAST_OCTET=1

# ---------- Почта ----------
# ВНИМАНИЕ: при "YES" письмо о создании клиента содержит .conf с ПРИВАТНЫМ ключом.
CLIENT_MAIL_ENABLED="YES"
CLIENT_MAIL_TO="admin@example.org"
CLIENT_MAIL_FROM="wg-watch@example.org"
CLIENT_MAIL_SMTP_HOST="127.0.0.1"
CLIENT_MAIL_SMTP_PORT="25"
