# =============================================================
#  wg-watch-web.env.example — конфиг веб-дашборда wg-watch (Flask)
#  Путь: "/opt/wg-watch/conf/wg-watch-web.env.example"
#  Права: "chmod 600", владелец "root".
#  Формат: "KEY=value"
# =============================================================

# ---------- Интерфейс (UI) ----------
EVENTS_LIMIT=300
EVENTS_LIMIT_PEER=300
# Размер events.log ограничивают EVENTS_MAX_LINES / EVENTS_KEEP_LINES в wg-watch-daemon.env
EVENTS_LIMIT_MAX=300

# ---------- Связь с Go-демоном (wg-watch-daemon) ----------
DAEMON_HOST=127.0.0.1
DAEMON_PORT=18082
DAEMON_TIMEOUT=2.0
# Должен совпадать с DAEMON_TOKEN в wg-watch-daemon.env
DAEMON_TOKEN=CHANGE_ME___openssl_rand_base64_32

# ---------- Связь с Go-менеджером (wg-watch-manager) ----------
MANAGER_HOST=127.0.0.1
MANAGER_PORT=18083
# Должен быть больше CLIENT_SCRIPT_TIMEOUT в wg-watch-manager.env
MANAGER_TIMEOUT=35.0
# Должен совпадать с MANAGER_TOKEN в wg-watch-manager.env
MANAGER_TOKEN=CHANGE_ME___openssl_rand_base64_32

# ---------- Токены: общий порог длины ----------
TOKEN_MIN_LEN=32

# ---------- Безопасность ----------
# Хосты, по которым разрешено обращаться (без схемы), через запятую.
# Пример: 127.0.0.1,localhost,192.168.0.200,vpn.example.org
ALLOWED_HOSTS=
# Доверенные Origin для CSRF (со схемой https:// или http://), через запятую.
# Пример: https://vpn.example.org,http://192.168.0.200:6060
CSRF_TRUSTED_ORIGINS=
# "1" — если дашборд снаружи за HTTPS-прокси; иначе форма логина не пройдёт.
CSRF_COOKIE_SECURE=1
CSRF_COOKIE_SAMESITE=Strict
SESSION_COOKIE_HTTPONLY=1
X_FRAME_OPTIONS=SAMEORIGIN
MAX_CONTENT_LENGTH=16384
NEXT_MAX_LEN=512

# ---------- Прокси ----------
PROXY_FIX_COUNT=1

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=wg-watch:
REDIS_TIMEOUT=1.0

# ---------- Аутентификация и сессии ----------
WEB_USER=admin
WEB_PASSWORD=CHANGE_ME!!!
# Сгенерировать: openssl rand -hex 32
WEB_SECRET_KEY=CHANGE_ME___openssl_rand_hex_32
WEB_PASSWORD_MIN_LEN=10
SECRET_KEY_MIN_LEN=16
SECRET_KEY_WARN_LEN=32
WEB_SESSION_TTL=43200
WEB_REMEMBER_TTL=604800

# ---------- Ограничения (rate-limit) ----------
LOGIN_MAX_FAILS=3
LOGIN_FAIL_WINDOW=300
LOGIN_BAN_SECONDS=180
LOGIN_MAX_TRACKED=10000
ACTION_MAX_REQUESTS=5
ACTION_WINDOW=60

# ---------- Клиенты ----------
CLIENTS_DIR=/etc/wireguard/clients
# Должна совпадать с CLIENT_NAME_MAX в wg-watch-manager.env
CLIENT_NAME_MAX=64
CLIENTS_CACHE_TTL=10.0

# ---------- Логи ----------
LOG_FILE=/opt/wg-watch/logs/wg-watch-web.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# ---------- Запуск ----------
HOST=127.0.0.1
PORT=6060
# Должен совпадать с <base href="..."> в index.html и login.html
URL_PREFIX=/wg-watch
FLASK_DEBUG=0

# ---------- Статика ----------
PUBLIC_STATIC_EXT=.css,.js,.png,.jpg,.jpeg,.gif,.svg,.webp,.ico,.woff,.woff2,.ttf,.webmanifest,.json
