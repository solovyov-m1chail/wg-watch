# =============================================================
#  wg-watch-manager.env.example — конфиг демона управления клиентами
#  Путь: "/opt/wg-watch/conf/wg-watch-manager.env.example"
#  Права: "chmod 600", владелец "root".
#  Формат: "KEY=value"
# =============================================================

# ---------- HTTP-демон (Go, wg-watch-manager) ----------
# Адрес и порт, на котором слушает менеджер (только 127.0.0.1).
MANAGER_HOST=127.0.0.1
MANAGER_PORT=18083

# ---------- Ограничения клиентов ----------
# Максимальная длина имени клиента, символов (должна совпадать с CLIENT_NAME_MAX
# в wg-watch-web.env; bash-скрипты жёстко ограничивают имя 64 символами,
# поэтому значение больше 64 не имеет смысла).
CLIENT_NAME_MAX=64
# Таймаут выполнения bash-скрипта, сек.
# Должен быть МЕНЬШЕ MANAGER_TIMEOUT в wg-watch-web.env.
CLIENT_SCRIPT_TIMEOUT=30

# ---------- Аутентификация ----------
# Общий секрет с Flask (заголовок "X-Manager-Token").
# Сгенерировать: openssl rand -base64 32
# Должен совпадать с MANAGER_TOKEN в wg-watch-web.env.
MANAGER_TOKEN=CHANGE_ME___openssl_rand_base64_32
TOKEN_MIN_LEN=32

# ---------- Пути ----------
MANAGER_LOG=/opt/wg-watch/logs/wg-watch-manager.log
CLIENT_SCRIPTS_DIR=/opt/wg-watch/scripts
