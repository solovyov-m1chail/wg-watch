# =============================================================
#  wg-watch-daemon.env.example — конфиг демона мониторинга WireGuard
#  Путь: "/opt/wg-watch/conf/wg-watch-daemon.env.example"
#  Права: "chmod 600", владелец "root".
#  Формат: "KEY=value"
# =============================================================

# ---------- WireGuard ----------
WG_IFACE=wg0

# ---------- Почта ----------
MAIL_ENABLED=true
MAIL_TO="admin@example.org"
MAIL_FROM="wg-watch@example.org"
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=25
MAIL_QUEUE_SIZE=4
MAIL_RETRIES=5
MAIL_RETRY_DELAY=5
MAIL_RETRY_MAX_DELAY=30

# ---------- Мониторинг (все значения — секунды) ----------
INTERVAL=2
PEER_TIMEOUT=200
OBSERVE_WINDOW=60
OFFLINE_CONFIRM=60
COOLDOWN=60
SAME_ENDPOINT_COOLDOWN=300
STALE_TIMEOUT=3600

# ---------- HTTP-демон (Go) ----------
DAEMON_HOST=127.0.0.1
DAEMON_PORT=18082

# ---------- Графики трафика ----------
TRAFFIC_WINDOW=300
TRAFFIC_TIMEOUT=60
TRAFFIC_HISTORY=86400
TRAFFIC_FILE=/opt/wg-watch/data/traffic-history.json
TRAFFIC_SAVE_INTERVAL=900

# ---------- events.log: ротация ----------
EVENTS_RETENTION_DAYS=15
EVENTS_TRIM_INTERVAL=3600
EVENTS_MAX_LINES=400
# Должно быть не меньше EVENTS_LIMIT и EVENTS_LIMIT_PEER из wg-watch-web.env
EVENTS_KEEP_LINES=300

# ---------- Механизм политик ----------
POLICY_FILE=/opt/wg-watch/conf/policy.conf
POLICY_LOG_FILE=/opt/wg-watch/logs/policy.log

# ---------- Аутентификация демона ----------
# Общий секрет с Flask (заголовок "X-Daemon-Token").
# Сгенерировать: openssl rand -base64 32
# Должен совпадать с DAEMON_TOKEN в wg-watch-web.env.
DAEMON_TOKEN=CHANGE_ME___openssl_rand_base64_32
TOKEN_MIN_LEN=32

# ---------- Пути ----------
PID_DIR=/opt/wg-watch/pids
CLIENTS_DIR=/etc/wireguard/clients
LOG_DIR=/opt/wg-watch/logs
LOG_FILE=/opt/wg-watch/logs/wg-watch-daemon.log
EVENTS_FILE=/opt/wg-watch/logs/events.log
